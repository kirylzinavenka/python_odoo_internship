<odoo>
    <data>
        <!-- Wizard Form View -->
        <record id="view_create_partner_wizard_form" model="ir.ui.view">
            <field name="name">create.partner.wizard.form</field>
            <field name="model">create.partner.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <field name="name"/>
                        <field name="is_company"/>
                    </group>
                    <footer>
                        <button
                            name="action_create"
                            string="Добавить"
                            type="object"
                            class="btn-primary"
                        />
                        <button
                            string="Отмена"
                            class="btn-secondary"
                            special="cancel"
                        />
                    </footer>
                </form>
            </field>
        </record>

        <!-- Wizard Action -->
        <record id="action_create_partner_wizard" model="ir.actions.act_window">
            <field name="name">Create Partner Wizard</field>
            <field name="res_model">create.partner.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="binding_model_id" ref="base.model_res_partner"/>
            <field name="binding_view_types">tree</field>
        </record>
    </data>
</odoo>
