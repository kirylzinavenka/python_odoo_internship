<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sale_order_express_only" model="ir.actions.act_window">
        <field name="name">Express delivery orders</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[("order_line.is_express_delivery", "=", True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No express orders to process!
            </p>
        </field>
    </record>

    <record id="view_order_form_inherit_tracking_button" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.tracking.button</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="button_open_odoo_page"
                        string="Odoo official page"
                        type="object"
                        class="oe_highlight"/>
            </xpath>
        </field>
    </record>

    <record id="action_server_verify_orders" model="ir.actions.server">
        <field name="name">Mark as verified</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
            for record in records:
                record.message_post(body="Order verified by development intern.")
        </field>
    </record>

    <record id="action_client_open_discuss" model="ir.actions.client">
        <field name="name">Open Discuss</field>
        <field name="tag">mail.action_discuss</field>
    </record>

    <menuitem id="menu_sale_order_express"
              name="Express delivery"
              parent="sale.menu_sale_report"
              action="action_sale_order_express_only"
    />
    <menuitem id="menu_discuss_shortcut"
              name="Quick Chat"
              parent="sale.menu_sale_report"
              action="action_client_open_discuss"
    />
</odoo>
