<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_line_split_wizard_view_form" model="ir.ui.view">
        <field name="name">sale.order.line.split.wizard.form</field>
        <field name="model">sale.order.line.split.wizard</field>
        <field name="arch" type="xml">
            <form string="Split line">
                <sheet>
                    <group>
                        <group>
                            <field name="order_line_id" readonly="True" options="{'no_open': True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Split details" name="split_details">
                            <field name="split_line_ids">
                                <list editable="bottom">
                                    <field name="quantity"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="button_apply_split"
                            string="Split"
                            type="object"
                            class="btn-primary"
                            data-hotkey="q"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"
                            data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sale_order_line_split_wizard" model="ir.actions.act_window">
        <field name="name">Split Line</field>
        <field name="res_model">sale.order.line.split.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
