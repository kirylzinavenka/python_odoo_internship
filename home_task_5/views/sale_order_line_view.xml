<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_line_view_form_inherit_split" model="ir.ui.view">
        <field name="name">sale.order.line.view.form.inherit.split</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='price_subtotal']" position="after">
                <button name="button_open_split_wizard"
                        type="object"
                        icon="fa-scissors"
                        title="Split line"
                        invisible="state not in ['draft', 'sent']"/>
            </xpath>
        </field>
    </record>
</odoo>
